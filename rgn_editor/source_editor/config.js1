CKEDITOR.editorConfig = function( config ) {
	// Define changes to default configuration here. For example:
	// config.language = 'fr';
	// config.uiColor = '#AADC6E';
	
	config.extraPlugins = 'fontawesome,youtube';
	config.contentsCss = 'https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css';
	config.allowedContent = true; 
	
	config.extraPlugins = 'file-manager';
	
	config.Flmngr = {
		//apiKey: "qLuj8Be3",
		apiKey: "FLMNFLMN",
		//urlFileManager: "https://demo.anmydesign.com/pico-saigon/flmngr/flmngr.php",
		//urlFiles: "https://demo.anmydesign.com/pico-saigon/fileman/Uploads/"
		urlFileManager: window.location.protocol+ "//"+window.location.host+"/flmngr/flmngr.php",
		urlFiles: window.location.protocol+ "//"+window.location.host+ "/fileman/Uploads/"
		
	};

	config.toolbar = [
	  // ...your toolbar goes here...
	  ["Flmngr", "Upload", "ImgPen"]
	];
	
};

// cập nhật xóa sinh script tự động <script data-ts="1785122703656" src="https://cdn.flmngr.com/widgets.js?apiKey=FLMNFLMN"></script> lưu vào csdl và bị hiển thị ngoài frontend 
CKEDITOR.on('instanceReady', function(ev) {
	// Filter when loading content into editor
	ev.editor.dataProcessor.dataFilter.addRules({
		elements: {
			script: function(element) {
				if (element.attributes.src && (element.attributes.src.indexOf('flmngr.com') !== -1 || element.attributes.src.indexOf('n1ed.com') !== -1)) {
					return false; // Remove the script tag
				}
			}
		}
	}, 999);

	// Filter when retrieving content from editor
	ev.editor.dataProcessor.htmlFilter.addRules({
		elements: {
			script: function(element) {
				if (element.attributes.src && (element.attributes.src.indexOf('flmngr.com') !== -1 || element.attributes.src.indexOf('n1ed.com') !== -1)) {
					return false; // Remove the script tag
				}
			}
		}
	}, 999);
});